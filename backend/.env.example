# Database Configuration
# Required. Uses postgresql+psycopg dialect (SQLAlchemy 2.x + psycopg v3)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/esp_db

# Application Settings (Placeholder)
# APP_ENV=
# SECRET_KEY=

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

